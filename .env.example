# --- App ---
ENVIRONMENT=dev
SECRET_KEY=change-me-32+chars-random
FIELD_ENCRYPTION_KEY=change-me-fernet-key   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CORS_ORIGINS=http://localhost:3000
HOSPITAL_TIMEZONE=Asia/Kolkata
# --- Database ---
POSTGRES_DB=hospital
POSTGRES_USER=hospital_migrator
POSTGRES_PASSWORD=change-me
APP_DB_USER=hospital_app
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql+asyncpg://hospital_app:change-me-too@db:5432/hospital
MIGRATION_DATABASE_URL=postgresql+asyncpg://hospital_migrator:change-me@db:5432/hospital
# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=                # optional low|medium|high; leave empty for models without effort support
AI_ENABLED=true
# --- Storage ---
STORAGE_BACKEND=local            # local | s3
UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Email ---
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# --- Ops ---
REDIS_URL=                       # e.g. redis://redis:6379/0 (prod: shared rate limits across workers)
SENTRY_DSN=
DOMAIN=localhost
