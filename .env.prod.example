# Copy to .env.prod on the server (chmod 600). Never commit the real file.
DOMAIN=hospital.example.org
ACME_EMAIL=ops@example.org
GHCR_OWNER=your-github-user-or-org
ENVIRONMENT=prod
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=https://hospital.example.org
HOSPITAL_TIMEZONE=Asia/Kolkata
POSTGRES_DB=hospital
POSTGRES_USER=hospital_migrator
POSTGRES_PASSWORD=
APP_DB_USER=hospital_app
APP_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://hospital_app:<APP_DB_PASSWORD>@db:5432/hospital
MIGRATION_DATABASE_URL=postgresql+asyncpg://hospital_migrator:<POSTGRES_PASSWORD>@db:5432/hospital
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
AI_ENABLED=true
STORAGE_BACKEND=local
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENTRY_DSN=
# first-run admin seed (python -m app.seed). Change the password immediately after first login.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
# backups
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/hospital
BACKUP_KEEP_DAYS=14
